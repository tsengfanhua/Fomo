# 複製成 .env 後依需要修改；所有項目都有預設值，不設定也能以離線規則模式執行。

# --- 伺服器 ---
PORT=8787
HOST=127.0.0.1
# 資料庫檔案位置（預設 ./var/fomothon.db）。專案若放在雲端同步資料夾，建議改到本機路徑。
# FOMO_DB_PATH=/tmp/fomothon.db
# 固定「今天」的日期（YYYY-MM-DD），讓截止日計算可重現；不設定則使用系統日期。
# FOMO_TODAY=2026-11-21
# 對外部署時的存取碼：設定後登入必須輸入，評審專用。
# FOMO_ACCESS_CODE=
# 是否允許在執行任務時注入工具故障（展示失敗處理用）。對外部署請設為 0。
FOMO_DEMO_FAULTS=1

# --- 課綱來源 ---
# http：以 HTTP 抓取課綱頁面（預設抓本機內建的示意課綱站）；local：直接讀資料庫（測試用）
FOMO_SYLLABUS_MODE=http
# FOMO_SYLLABUS_BASE_URL=http://127.0.0.1:8787/campus

# --- MCP 伺服器 ---
# stdio 模式（node src/mcp/stdio.js）綁定的帳號
FOMO_MCP_USER=S01
# 開啟 Streamable HTTP 端點 /mcp（需要個人權杖：npm run mcp:token -- issue S01）
FOMO_MCP_HTTP=0

# --- 模型路由（選用）：config/models.json 的路由名稱 ---
# claude | claude-tiered | local | hybrid | openai | gemini；設定後優先於下方的單一端點設定
# FOMO_LLM_PROFILE=claude-tiered
# 地端模型（OpenAI 相容 API，例如 Ollama）
# FOMO_LOCAL_MODEL=qwen3:8b
# FOMO_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
# OpenAI 與 Gemini：模型名稱請依帳號可用的模型設定；單價（美元／百萬 token）用於估算成本
# FOMO_OPENAI_MODEL=
# FOMO_OPENAI_PRICE_IN=
# FOMO_OPENAI_PRICE_OUT=
# FOMO_GEMINI_MODEL=
# GEMINI_API_KEY=

# --- LLM 單一端點（選用；預設 none＝離線規則模式，不對外傳送任何資料）---
# none | anthropic | openai-compatible
FOMO_LLM_PROVIDER=none
# anthropic 預設 claude-opus-5-5；openai-compatible 必須自行指定模型
# FOMO_LLM_MODEL=
# anthropic：由官方 SDK 讀取 ANTHROPIC_API_KEY（需先 npm install）
# ANTHROPIC_API_KEY=
# openai-compatible：任何相容 /chat/completions 的端點
# FOMO_LLM_BASE_URL=https://api.openai.com/v1
# FOMO_LLM_API_KEY=
# 單次呼叫逾時（毫秒），逾時即退回規則模式
FOMO_LLM_TIMEOUT_MS=20000
# 成本估算用單價（美元／百萬 token）；不設定則只記錄 token 數
# FOMO_LLM_PRICE_IN=
# FOMO_LLM_PRICE_OUT=
